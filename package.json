{
  "name": "fretboard-studio",
  "version": "1.10.3",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-syntax.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts tests *.mjs",
    "test": "node --test --test-isolation=none tests/unit/*.test.js",
    "test:e2e": "playwright test",
    "validate": "npm run check && npm test && npm run typecheck && npm run lint && npm run build && npm run test:e2e"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/three": "0.183.1",
    "esbuild": "0.25.12",
    "eslint": "9.39.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "three": "0.186.1"
  }
}
